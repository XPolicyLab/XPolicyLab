# Auriga machine settings for the policy server.
#   cp config.env.example config.env && chmod 600 config.env    # config.env is git-ignored
# Read by setup_eval_policy_server.sh and the install scripts (config_env.sh): a variable already exported
# with a non-empty value wins over its line here. Nothing in this file is a secret except the two API lines.

# -- model endpoint ------------------------------------------------------------------------------
# The endpoint and its key are PROVIDED BY THE AURIGA TEAM, sent privately to the evaluators
# together with the evaluation application. They are never committed to this repository.
# Inject them either by filling the two lines below in the untracked config.env, or by exporting
# AURIGA_API_BASE_URL / AURIGA_API_KEY in the environment that runs eval.sh, or by pointing
# AURIGA_API_KEY_FILE at a 0600 file that holds only the key.
# The endpoint speaks the OpenAI Responses API (POST <base>/responses); Chat Completions is not used.
AURIGA_API_BASE_URL=
AURIGA_API_KEY=
AURIGA_API_KEY_FILE=
# Model id and reasoning effort behind that endpoint (fixed for the leaderboard run).
AURIGA_MODEL=gpt-6-astra
AURIGA_REASONING_EFFORT=high

# -- Auriga checkout -----------------------------------------------------------------------------
# Empty: third_party/Auriga, cloned by install.sh from https://github.com/StellarEdge-AI/Auriga at
# the commit pinned in deploy.yml (auriga_commit).
AURIGA_SRC=

# -- external perception service (VGGT-Omega + SAM 3.1) ------------------------------------------
# install.sh / download_assets.sh put the venvs and weights here; the policy server starts the
# services on 127.0.0.1 (next free ports from VGGT_PORT / SAM31_PORT), waits for health and stops
# them on exit.
# Service code: services/vggt_height of the Auriga checkout.
VGGT_HOME=./third_party/vggt_home
VGGT_PORT=8331
SAM31_PORT=8333
# GPU for the perception service (about 15 GB). Empty: the policy GPU of eval.sh.
VGGT_GPU=
# Weight source: modelscope needs no Hugging Face token for the two gated repositories.
VGGT_SOURCE=modelscope
SAM31_SOURCE=modelscope
