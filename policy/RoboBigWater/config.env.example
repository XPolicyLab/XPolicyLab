# Copy to config.env and edit. config.env is not tracked by git.

# ---- simulator side ----
# RoboDojo checkout (with Assets/ downloaded) and the Python of its Isaac Sim 5.1 environment
ROBODOJO_REPO=/path/to/RoboDojo
ISAAC_PYTHON=/path/to/isaacsim-env/bin/python
# Optional: a directory for the Isaac Sim caches. Keep it between runs, a cold cache costs 10+ minutes.
SIM_CACHE=
# Optional: extra library directories for Isaac Sim, colon separated
EXTRA_LD_LIBRARY_PATH=
# Optional: a wrapper that locks a GPU: `$GPU_LOCK <gpu> <owner> --min-free-mib <n> -- <command...>`
GPU_LOCK=
# On a machine shared by several users give everyone a private temp directory, otherwise /tmp/isaaclab belongs to
# whoever ran first and everybody else gets PermissionError at reset:
#   TMPDIR=/tmp/roboshell-<user>
TMPDIR=

# ---- agent side ----
# Codex CLI binary on this host; codex-code-mode-host must be next to it
CODEX_BIN=$HOME/.local/bin/codex
# Model endpoint, OpenAI Responses API. The key stays on the host: the egress proxy adds it.
MODEL_UPSTREAM=https://api.example.com
MODEL_BASE_PATH=/v1
MODEL_KEY_FILE=$HOME/.config/roboshell/api-key
MODEL=gpt-6-astra
EFFORT=medium
# Optional: extra query parameters as a TOML inline table body. Keep the whole value in single quotes:
#   MODEL_QUERY_PARAMS='client_version = "0.155.1"'
MODEL_QUERY_PARAMS=

# ---- image build ----
BASE_IMAGE=debian:bookworm-slim
APT_MIRROR=deb.debian.org
