+    exit 1
+  fi
+  echo "[INFO] ROBODOJO_NUM_ENVS override: ${num_envs} -> ${ROBODOJO_NUM_ENVS}"
+  num_envs="${ROBODOJO_NUM_ENVS}"
+fi
 
