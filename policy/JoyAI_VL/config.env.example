# Public configuration template. Copy to config.env and edit; keep config.env private.
# Alternatively generate this file with tools/configure.py from this policy directory.
ROBODOJO_REPO=/path/to/RoboDojo
ISAAC_PYTHON=/path/to/isaac-env/bin/python
MODEL_UPSTREAM=https://api.example.com
MODEL_BASE_PATH=/v1
MODEL_KEY_FILE=$HOME/.config/joyai-vl/api-key
# Replace with the model ID accepted by your serving endpoint.
MODEL=JoyAI-VL
HEXASHELL_REASONING_EFFORT=max
HEXASHELL_CHAT_TEMPLATE_KWARGS='{"thinking_mode":"thinking","reasoning_effort":"max","drop_thinking":false}'
HEXASHELL_MAX_TOKENS=65536
HEXASHELL_TEMPERATURE=0
HEXASHELL_STREAM=0
HEXASHELL_HISTORY_REASONING=1
HEXASHELL_MAX_TURNS=100
HEXASHELL_REQUEST_TIMEOUT_S=900
HEXASHELL_SKILLS=0
ROBOSHELL_RECIPE=0
ROBOSHELL_NOTES=0
ROBOSHELL_PROFILE=open
HEXASHELL_SAM3_URL=http://127.0.0.1:18300
HEXASHELL_MOTION=v2
IMAGE=joyai-vl/agent:preview
BASE_IMAGE=python:3.11-slim-bookworm
SIM_CACHE=
TMPDIR=
EXTRA_LD_LIBRARY_PATH=
# This variant uses the same generic tools for every task.
