{
  "schema": "riemann-declarative-skill-workflow-v1",
  "mode": "rule_only",
  "official_action_horizon": 800,
  "wam_reselection": false,
  "max_operations": 128,
  "bindings": {
    "prepare_move": "skills.bowl_state.implementation:prepare_transfer",
    "candidate_order": "skills.source_grasp.implementation:candidate_order",
    "candidate_selected": "skills.source_grasp.implementation:candidate_selected",
    "preflight_candidate": "skills.source_grasp.implementation:preflight_candidate",
    "require_candidate": "skills.source_grasp.implementation:require_candidate",
    "approach": "skills.source_grasp.implementation:approach",
    "descend": "skills.source_grasp.implementation:descend",
    "close": "skills.source_grasp.implementation:close",
    "close_settle": "skills.source_grasp.implementation:close_settle",
    "check_close": "skills.source_grasp.implementation:check_close",
    "lift": "skills.loaded_transport.implementation:lift",
    "check_lift": "skills.source_grasp.implementation:check_lift",
    "retract_loaded": "skills.loaded_transport.implementation:retract_loaded",
    "prepare_upright": "skills.loaded_transport.implementation:prepare_upright",
    "upright": "skills.loaded_transport.implementation:upright",
    "carry": "skills.loaded_transport.implementation:carry",
    "check_carry": "skills.source_grasp.implementation:check_carry",
    "place": "skills.placement.implementation:place",
    "prepare_release": "skills.placement.implementation:prepare_release",
    "requires_narrow_release": "skills.placement.implementation:requires_narrow_release",
    "narrow_open": "skills.placement.implementation:narrow_open",
    "narrow_hold": "skills.placement.implementation:narrow_hold",
    "check_narrow_opening": "skills.placement.implementation:check_narrow_opening",
    "public_evidence_failed": "skills.bowl_state.implementation:public_evidence_failed",
    "note_public_release_failure": "skills.bowl_state.implementation:note_public_release_failure",
    "withdraw": "skills.placement.implementation:withdraw",
    "full_open": "skills.placement.implementation:full_open",
    "full_open_settle": "skills.placement.implementation:full_open_settle",
    "retreat": "skills.placement.implementation:retreat",
    "home": "skills.source_recovery.implementation:home"
  },
  "errors": {"runtime_failure": "skills.bowl_state.implementation:RuntimeFailure"},
  "steps": [
    {"id": "source_rgb_targets_and_arm", "call": "prepare_move"},
    {"call": "candidate_order", "store": "candidate_tilts"},
    {
      "for_each": {"var": "candidate_tilts"}, "as": "tilt", "max_items": 2,
      "do": [
        {"call": "candidate_selected", "store": "selected"},
        {"if": {"var": "selected"}, "then": [],
         "else": [{"call": "preflight_candidate", "args": {"tilt": {"var": "tilt"}}}]}
      ]
    },
    {"call": "require_candidate"},
    {"id": "original_approach", "call": "approach"},
    {"id": "original_rim_grasp", "call": "descend"},
    {"id": "original_close70", "call": "close"},
    {"id": "original_close_settle100", "call": "close_settle"},
    {"call": "check_close"},
    {"id": "original_lift", "call": "lift"},
    {"call": "check_lift"},
    {"id": "original_loaded_retract", "call": "retract_loaded"},
    {"id": "third_bowl_predicted_joint_preflight", "call": "prepare_upright"},
    {"id": "original_upright", "call": "upright"},
    {"id": "original_carry_closed", "call": "carry"},
    {"call": "check_carry"},
    {"id": "original_place_closed", "call": "place"},
    {"call": "prepare_release"},
    {"call": "requires_narrow_release", "store": "narrow"},
    {
      "if": {"var": "narrow"},
      "then": [
        {"id": "original_narrow80_with_own_arm_hold", "call": "narrow_open"},
        {"id": "original_narrow_hold100", "call": "narrow_hold"},
        {"call": "check_narrow_opening", "store": "release_evidence"},
        {"call": "public_evidence_failed", "args": {"evidence": {"var": "release_evidence"}}, "store": "release_failed"},
        {"if": {"var": "release_failed"},
         "then": [{"call": "note_public_release_failure", "args": {"evidence": {"var": "release_evidence"}}}],
         "else": [{"id": "unknown_continues_original_narrow_withdraw", "call": "withdraw"}]}
      ],
      "else": []
    },
    {"id": "original_full_release80", "call": "full_open"},
    {"id": "original_full_release_settle100", "call": "full_open_settle"},
    {"id": "original_retreat", "call": "retreat"},
    {"id": "original_both_arm_home", "call": "home"}
  ]
}
