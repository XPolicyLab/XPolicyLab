{
  "schema": "riemann-declarative-generator-workflow-v1",
  "mode": "rule_only", "official_action_horizon": 600, "wam_reselection": false, "max_operations": 1024,
  "bindings": {
    "initialize_scene": "skills.interaction.implementation:initialize_scene",
    "wait_opponent": "skills.interaction.implementation:wait_opponent",
    "clear_rack_view": "skills.interaction.implementation:clear_rack_view",
    "wait_discard": "skills.interaction.implementation:wait_discard",
    "select_arm": "skills.reveal.implementation:select_arm",
    "prepare_reveal": "skills.reveal.implementation:prepare",
    "turn_tile": "skills.reveal.implementation:turn_tile",
    "finish_reveal": "skills.reveal.implementation:finish",
    "home": "skills.motion.implementation:home",
    "prepare_pickup": "skills.pickup.implementation:prepare",
    "approach_pickup": "skills.pickup.implementation:approach",
    "close_pickup": "skills.pickup.implementation:close",
    "lift_pickup": "skills.pickup.implementation:lift",
    "turn_upright": "skills.transfer.implementation:turn_upright",
    "receive_right": "skills.transfer.implementation:receive",
    "release_first": "skills.transfer.implementation:release_first",
    "clear_first": "skills.transfer.implementation:clear_first",
    "approach_place": "skills.placement.implementation:approach",
    "release_place": "skills.placement.implementation:release",
    "review_place": "skills.placement.implementation:review",
    "record_refusal": "skills.recovery.implementation:record_refusal",
    "release_and_home": "skills.recovery.implementation:release_and_home",
    "final_hold": "skills.recovery.implementation:final_hold"
  },
  "errors": {"PlanError": "skills.motion.implementation:PlanError"},
  "steps": [
    {"id": "public_closed_loop", "try": [
      {"id": "observe_initial_public_scene", "call": "initialize_scene"},
      {"id": "wait_for_completed_public_discard", "call": "wait_opponent"},
      {"id": "clear_own_hand_and_reobserve", "call": "clear_rack_view"},
      {"id": "wait_opponent_and_match", "call": "wait_discard", "store": "tiles"},
      {"id": "choose_public_reach", "call": "select_arm", "args": {"indices": {"var": "tiles"}}, "store": "arm"},
      {"id": "close_contact_tool", "call": "prepare_reveal", "args": {"arm": {"var": "arm"}}},
      {"id": "matching_triplet", "for_each": {"var": "tiles"}, "as": "tile", "max_items": 3,
       "do": [{"id": "turn_one_matching_tile", "call": "turn_tile", "args": {"index": {"var": "tile"}, "arm": {"var": "arm"}}}]},
      {"id": "release_reveal_tool", "call": "finish_reveal", "args": {"arm": {"var": "arm"}}},
      {"id": "home_reveal_arm", "call": "home", "args": {"arm": {"var": "arm"}}},
      {"id": "locate_current_stack", "call": "prepare_pickup"},
      {"id": "approach_stack", "call": "approach_pickup"},
      {"id": "close_on_replacement", "call": "close_pickup"},
      {"id": "lift_and_reobserve", "call": "lift_pickup"},
      {"id": "turn_upright_and_reobserve", "call": "turn_upright"},
      {"id": "receive_with_right", "call": "receive_right"},
      {"id": "release_left", "call": "release_first"},
      {"id": "clear_left_and_reobserve", "call": "clear_first"},
      {"id": "approach_observed_destination", "call": "approach_place"},
      {"id": "release_replacement", "call": "release_place"},
      {"id": "review_current_placement", "call": "review_place"}
    ], "catch": [{"errors": ["PlanError"], "as": "refusal",
                  "do": [{"id": "record_expected_refusal", "call": "record_refusal", "args": {"error": {"var": "refusal"}}}]}]},
    {"id": "finish_open_and_home", "call": "release_and_home"},
    {"id": "await_actual_official_terminal", "call": "final_hold"}
  ]
}
