{
  "provider": "anthropic",
  "model": "claude-opus-5-5",
  "base_url": "",
  "python_prefix": "",
  "sandbox": "docker",
  "prompt_cache": true,
  "context_history": "first_recent",
  "context_max_bytes": 33554432,
  "cache_ttl": "1h",
  "stream": true,
