  "network_recovery_window_s": 600,
  "python_memory_limit_mib": 16384,
  "sandbox_image": "ubuntu:24.04",
  "http_400_max_attempts": 15,
  "anthropic_tool_image_mode": "top_level",
  "api_key_env": "Q0_PREVIEW_API_KEY"
}
