# HexaShell-1.5 machine settings, read by install.sh, setup_eval_policy_server.sh and scripts/sam3_service.sh.
#   cp config.env.example config.env      # config.env is not tracked; install.sh does this on its first run
# The file is sourced by bash; HEXASHELL_<NAME> lines override the deploy.yml setting <name>.

# -- the model endpoint -------------------------------------------------------------------------
# An OpenAI-compatible chat completions endpoint that serves gpt-6-astra (streaming).
HEXASHELL_API_BASE=https://api.openai.com/v1
HEXASHELL_MODEL=gpt-6-astra
HEXASHELL_REASONING_EFFORT=high
# The key: one line in this file (chmod 600), or OPENAI_API_KEY in the environment. It is read by the
# policy server only and never reaches the process that runs the model's code.
HEXASHELL_API_KEY_FILE=$HOME/.config/hexashell/api-key

# -- SAM3 (segmentation service on this machine) ------------------------------------------------
# Python with torch 2.7 + CUDA and sam3 (install.sh sets it up in the policy environment by default),
# and the checkpoint sam3.pt (install.sh downloads it here when it is missing).
SAM3_PYTHON=
SAM3_CHECKPOINT_PATH=/path/to/checkpoints/sam3.pt
# Port of the service (deploy.yml sam3_url is set from it) and its GPU (empty: the policy GPU).
SAM3_PORT=18300
SAM3_GPU=

# -- the policy environment ---------------------------------------------------------------------
# install.sh creates this conda environment (Python 3.11 + requirements.txt); pass the same name as
# <policy_env> to eval.sh.
POLICY_CONDA_ENV=hexashell
